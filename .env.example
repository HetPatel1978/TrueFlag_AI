APP_ENV=local
BACKEND_PORT=8010
FRONTEND_PORT=8088
# Run python scripts/init_env.py; it generates real local values without printing them.
JWT_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://trueflag:CHANGE_LOCALLY@127.0.0.1:5432/trueflag
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
JWT_ISSUER=trueflag-ai
JWT_AUDIENCE=trueflag-api
ACCESS_TOKEN_MINUTES=60
# Optional local-development remembered login; empty disables it. Ignored outside APP_ENV=local.
LOCAL_PERSISTENT_LOGIN_USERNAME=
MAX_REQUEST_BYTES=65536
LOGIN_ATTEMPT_LIMIT=10
LOGIN_WINDOW_SECONDS=60
ASSESSMENT_API_RATE_LIMIT=120
ASSESSMENT_API_WINDOW_SECONDS=60
ASSESSMENT_QUEUE_CAPACITY=1000
CSV_MAX_BYTES=1048576
CSV_MAX_ROWS=2000
CSV_MAX_COLUMNS=64
CSV_MAX_FIELD_BYTES=16384
CSV_RETENTION_SECONDS=86400
CSV_MAX_ACTIVE_UPLOADS=10
CSV_MAX_CONCURRENT_UPLOADS=4
CSV_CLEANUP_INTERVAL_SECONDS=300
CSV_MAX_VALIDATION_VERSIONS=5
CSV_MAX_CONCURRENT_VALIDATIONS=2
CSV_VALIDATION_TIMEOUT_SECONDS=10
CSV_IMPORT_CHUNK_SIZE=50
CSV_IMPORT_QUEUE_CAPACITY=100
CSV_IMPORT_ACTOR_CAPACITY=3
CSV_IMPORT_LEASE_SECONDS=60
CSV_IMPORT_CHUNK_TIMEOUT_SECONDS=10
BATCH_ASSESSMENT_GROUP_SIZE=10
BATCH_ASSESSMENT_CAPACITY=20
BATCH_ASSESSMENT_ACTOR_CAPACITY=3
BATCH_ASSESSMENT_INTERVAL_SECONDS=2
BATCH_ASSESSMENT_GROUPS_PER_TICK=3
# Compose enables the bounded dispatcher; it acts only on explicit Start Assessment records.
BATCH_ASSESSMENT_DISPATCH_ENABLED=false
BATCH_EXPORT_MAX_ROWS=500
BATCH_EXPORT_MAX_BYTES=1048576
# Host default: runtime/csv-staging. Compose sets /app/runtime/csv-staging on a private volume.
# CSV_STAGING_ROOT=C:/absolute/private/path/csv-staging
# Week 3: no provider or credentials configured by default.
INVESTIGATION_SIMULATION_ENABLED=false
# Unsupported external activation fails closed; no real adapter is registered.
INVESTIGATION_EXTERNAL_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
